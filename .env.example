# Copia in .env (NON committato) e inserisci i valori reali.
# In locale vengono letti via python-dotenv; su Streamlit Cloud vanno nei Secrets
# del dashboard (chiavi TOP-LEVEL, non dentro una [sezione]). Mai committare.

# --- Anthropic (passi 2 e 3A) ---
ANTHROPIC_API_KEY=sk-ant-api03-INSERIRE-QUI-LA-CHIAVE
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Supabase (passo 4) — progetto logos-flow-prod ---
# URL e anon key: Project Settings → API. service_role: stessa pagina (PRIVATA,
# bypassa la RLS; usata per upload Storage + insert). MAI committare.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
